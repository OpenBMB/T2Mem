# T2Mem configuration template.
#   cp .env.example .env
#   # Fill in the actual endpoints, served model names, and keys below.
#   python run.py --check --temperature 0.0 --answer-max-tokens 1024
#   python run.py --temperature 0.0 --answer-max-tokens 1024
# run.py automatically reads the repository .env. Environment variables take
# precedence; CLI options take precedence over both. No shell sourcing is needed.
# Existing scripts/*.sh remain available; export .env before using those directly:
#   set -a; source .env; set +a

# -----------------------------------------------------------------------------
# 1. LLM: episode indexing, controller, and final answer
# -----------------------------------------------------------------------------
# OpenAI-compatible API root, including /v1 when required by the deployment.
T2MEM_LLM_BASE_URL="http://127.0.0.1:8010/v1"
# Exact served model name; replace the placeholder before running model stages.
# Paper backbones: Qwen3.5-27B and Gemma4-31B-Instruct.
# Use the actual served alias for the selected backbone.
T2MEM_LLM_MODEL_NAME="your-served-model"
# Leave empty only for endpoints that do not require authentication.
T2MEM_LLM_API_KEY=""
# Optional separate controller and answer models, served on the same endpoint.
# T2MEM_CONTROLLER_MODEL_NAME="your-controller"
# T2MEM_ANSWER_MODEL_NAME="your-answer"

# -----------------------------------------------------------------------------
# 2. Retrieval embeddings: both benchmarks and all representations
# -----------------------------------------------------------------------------
EMBED_BACKEND="api"                 # api | local
# Paper metadata retrieval uses BGE-M3.
T2MEM_EMBEDDING_BASE_URL="http://127.0.0.1:8011/v1"
T2MEM_EMBEDDING_MODEL_NAME="bge-m3"
T2MEM_EMBEDDING_API_KEY=""
# Used only with EMBED_BACKEND=local; install requirements-local.txt first.
# A local model directory or a Hugging Face sentence-transformers model ID.
T2MEM_EMBEDDING_MODEL="BAAI/bge-m3"

# -----------------------------------------------------------------------------
# 3. LLM judge: independent endpoint, key, and served model
# -----------------------------------------------------------------------------
# Required for the default full pipeline. Use --skip-eval for inference only.
# Paper evaluation uses Qwen3.5-Plus.
JUDGE_BASE_URL=""
JUDGE_API_KEY=""
JUDGE_MODEL="qwen3.5-plus"

# -----------------------------------------------------------------------------
# 4. Optional experiment settings
# -----------------------------------------------------------------------------
# Relative DATA_ROOT and OUT_DIR paths are resolved from the repository root.
# DATA_ROOT="data"
# OUT_DIR="eval-results"
# WORKERS=8
# MAX_STEPS=5
# VARIANT="structured"              # structured | summary
# T2MEM_REQUEST_TIMEOUT=120           # seconds per request
# T2MEM_RETRIEVAL_TOP_K=10             # ranked candidates generated by retrieval
# T2MEM_READ_TOP_K=5                  # candidates initially shown to the reader
# Put locomo10.json and/or longmemeval_s_cleaned.json directly in data/.
# data/raw/ is also supported. Generated files are created automatically.

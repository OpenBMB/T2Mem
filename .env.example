# Copy to .env, edit, then: set -a; source .env; set +a
# LLM used by episode indexing and T2Mem inference.
T2MEM_LLM_BASE_URL=http://127.0.0.1:8010/v1
T2MEM_LLM_MODEL_NAME=your-served-model
T2MEM_LLM_API_KEY=

# Embedding API (currently supported for structured LoCoMo wiki retrieval).
T2MEM_EMBEDDING_BASE_URL=http://127.0.0.1:8011/v1
T2MEM_EMBEDDING_MODEL_NAME=bge-m3
T2MEM_EMBEDDING_API_KEY=
# For local retrieval, set a sentence-transformers model path or model ID.
T2MEM_EMBEDDING_MODEL=BAAI/bge-m3

# LLM judge; its endpoint and key are required for evaluation.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=qwen3.5-plus

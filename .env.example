# T2Mem configuration template. Run these commands from the repository root:
#   cp .env.example .env
#   # Edit .env with your deployment settings.
#   set -a
#   source .env
#   set +a
# Runners do not load .env automatically. Export it in each new shell.
# Quote values containing spaces or shell metacharacters. Keep real keys in .env.

# -----------------------------------------------------------------------------
# 1. LLM: episode indexing, controller, and final answer
# -----------------------------------------------------------------------------
# OpenAI-compatible API root, including /v1 when required by your deployment.
T2MEM_LLM_BASE_URL="http://127.0.0.1:8010/v1"
# Exact served model name, not the local model directory.
T2MEM_LLM_MODEL_NAME="your-served-model"
# Leave empty only for local endpoints that do not require authentication.
T2MEM_LLM_API_KEY=""
# Controller and answer use this model by default. To use separate models:
#   bash scripts/run_t2mem.sh locomo full \
#     --controller-model-name your-controller --answer-model-name your-answer
# Both models must be served by T2MEM_LLM_BASE_URL.

# -----------------------------------------------------------------------------
# 2. Retrieval embeddings
# -----------------------------------------------------------------------------
# API backend: supported for structured LoCoMo wiki retrieval.
T2MEM_EMBEDDING_BASE_URL="http://127.0.0.1:8011/v1"
T2MEM_EMBEDDING_MODEL_NAME="bge-m3"
T2MEM_EMBEDDING_API_KEY=""
# Local backend: used by LongMemEval, raw retrieval, and summary retrieval.
# Requires requirements-local.txt. Use a model directory or Hugging Face model ID.
T2MEM_EMBEDDING_MODEL="BAAI/bge-m3"
# Override the backend for one command, for example:
#   EMBED_BACKEND=local bash scripts/run_retrieval.sh locomo wiki

# -----------------------------------------------------------------------------
# 3. LLM judge: independent endpoint, key, and model
# -----------------------------------------------------------------------------
# Endpoint and key are required when running evaluation.
JUDGE_BASE_URL=""
JUDGE_API_KEY=""
JUDGE_MODEL="qwen3.5-plus"

# -----------------------------------------------------------------------------
# 4. Optional runner settings (uncomment only what you need)
# -----------------------------------------------------------------------------
# DATA_ROOT="/absolute/path/to/data"
# OUT_DIR="/absolute/path/to/eval-results"
# PYTHON="/absolute/path/to/python"
# WORKERS=8
# MAX_STEPS=5
# VARIANT="structured"              # structured | summary
# TOP_K changes both retrieval and reader counts if exported globally.
# Prefer setting it per stage: retrieval defaults to 10, initial reading to 5.
#   TOP_K=10 bash scripts/run_retrieval.sh locomo wiki
#   TOP_K=5 bash scripts/run_t2mem.sh locomo full
